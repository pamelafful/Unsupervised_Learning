```{r,nn_gridsearch,eval=T,echo=F}
hidden_options <- list( c(2),c(5), c(10), c(15))
l1_options <- c(0.05,0.15,0.25) #l1 options
epochs_options <- c(500, 1000, 1500,2000)

feature_names=names(subset(train_scaled,select=-fully_booked_30))
target=names(subset(train_scaled,select=fully_booked_30))



n_cores <- parallel::detectCores() - 1  # leave one core free
cl <- makeCluster(n_cores)
clusterEvalQ(cl, library(h2o))
registerDoParallel(cl)

listings_grid <- h2o.grid(
  algorithm = "deeplearning",
  grid_id = "listings_nn_grid_",
  hyper_params = list(
    hidden = hidden_options,
    l1 = l1_options,
    epochs = epochs_options
  ),
  x = feature_names,
  y = target,
  training_frame = listings_h2o_train,
  activation = "Tanh",
  seed = 1,
  reproducible = TRUE,
  balance_classes=T, # again for imabalnced data
  fold_assignment = "Stratified", # for balanced validation/train sets since data is imbalanced
  nfolds = 10,
  variable_importances = TRUE,
  export_weights_and_biases = TRUE
)

h2o.saveGrid(grid_directory = "SL_Assignment_3",

             grid_id = "listings_nn_grid_")

stopCluster(cl)
registerDoSEQ()

saveRDS(listings_grid, "nn_listings_grid_.rds")
nn_model=readRDS("nn_listings_grid.rds")


nn_model=h2o.loadGrid(grid_path="SL_Assignment_3/listings_nn_grid_")

grid_results=h2o.getGrid(
